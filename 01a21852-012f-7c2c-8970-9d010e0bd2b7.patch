index 0000000..203c0d6
--- /dev/null
+++ b/src/error.rs
@@ -0,0 +1,81 @@
+//! Error type shared across RPF.
+//!
+//! A single flat error type keeps the dependency-free promise (no `anyhow`)
+//! while still carrying context. Errors are built with [`Error::new`] and
+//! annotated with [`Error::context`] as they bubble up.
+
+use std::fmt;
+
+pub type Result<T> = std::result::Result<T, Error>;
+
+#[derive(Debug)]
+pub struct Error {
+    msg: String,
+}
+
+impl Error {
+    pub fn new(msg: impl Into<String>) -> Self {
+        Error { msg: msg.into() }
+    }
+
+    /// Prefix the message with additional context, e.g. the file being read.
+    pub fn context(self, ctx: impl fmt::Display) -> Self {
+        Error {
+            msg: format!("{}: {}", ctx, self.msg),
+        }
+    }
+
+    pub fn message(&self) -> &str {
+        &self.msg
+    }
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.msg)
+    }
+}
+
+impl std::error::Error for Error {}
+
+impl From<std::io::Error> for Error {
+    fn from(e: std::io::Error) -> Self {
+        Error::new(e.to_string())
+    }
+}
+
+impl From<std::num::ParseIntError> for Error {
+    fn from(e: std::num::ParseIntError) -> Self {
+        Error::new(e.to_string())
+    }
+}
+
+impl From<std::str::Utf8Error> for Error {
+    fn from(e: std::str::Utf8Error) -> Self {
+        Error::new(e.to_string())
+    }
+}
+
+impl From<std::string::FromUtf8Error> for Error {
+    fn from(e: std::string::FromUtf8Error) -> Self {
+        Error::new(e.to_string())
+    }
+}
+
+/// Convenience macro that builds an [`Error`] with `format!` syntax.
+#[macro_export]
+macro_rules! bail {
+    ($($arg:tt)*) => {
+        return Err($crate::Error::new(format!($($arg)*)))
+    };
+}
+
+/// Fail with a formatted message unless the condition holds.
+#[macro_export]
+macro_rules! ensure {
+    ($cond:expr, $($arg:tt)*) => {
+        if !$cond {
+            $crate::bail!($($arg)*);
+        }
+    };
+}
diff --git a/src/fetch.rs b/src/fetch.rs
new file mode 100644
index 0000000..f50ce4b
--- /dev/null
+++ b/src/fetch.rs
@@ -0,0 +1,373 @@
+//! Transport: fetching URLs and decompressing metadata.
+//!
+//! RPF is dependency-free, so instead of linking an HTTP/TLS stack it drives
+//! the system `curl` (present on every Fedora installation) and `xz`/`zstd`/
+//! `gzip` for compression. Local `file://` URLs are handled in-process, which
+//! is what makes repository fixtures testable without a network.
+
+use crate::{Error, Result};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+/// Where a URL points.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Scheme {
+    File,
+    Http,
+    Https,
+}
+
+pub fn scheme_of(url: &str) -> Option<Scheme> {
+    if url.starts_with("file://") {
+        Some(Scheme::File)
+    } else if url.starts_with("https://") {
+        Some(Scheme::Https)
+    } else if url.starts_with("http://") {
+        Some(Scheme::Http)
+    } else if url.starts_with('/') {
+        Some(Scheme::File)
+    } else {
+        None
+    }
+}
+
+/// Convert a `file://` URL (or bare path) into a filesystem path.
+pub fn local_path(url: &str) -> Option<PathBuf> {
+    if let Some(rest) = url.strip_prefix("file://") {
+        // file:///path -> /path ; file://host/path is not supported.
+        if rest.starts_with('/') {
+            Some(PathBuf::from(rest))
+        } else {
+            None
+        }
+    } else if url.starts_with('/') {
+        Some(PathBuf::from(url))
+    } else {
+        None
+    }
+}
+
+/// Join a base URL and a relative path, tolerating both trailing and missing
+/// slashes on either side.
+pub fn join_url(base: &str, rel: &str) -> String {
+    let base = base.trim_end_matches('/');
+    let rel = rel.trim_start_matches('/');
+    format!("{}/{}", base, rel)
+}
+
+fn require_curl() -> Result<()> {
+    static CHECKED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    let ok = *CHECKED.get_or_init(|| {
+        Command::new("curl")
+            .arg("--version")
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .status()
+            .map(|s| s.success())
+            .unwrap_or(false)
+    });
+    if ok {
+        Ok(())
+    } else {
+        Err(Error::new(
+            "the 'curl' command is required for network access but was not found in PATH",
+        ))
+    }
+}
+
+/// Fetch a URL to memory. Intended for small documents (repomd, metalink).
+pub fn fetch_bytes(url: &str) -> Result<Vec<u8>> {
+    match scheme_of(url) {
+        Some(Scheme::File) => {
+            let path = local_path(url).ok_or_else(|| Error::new(format!("bad file URL {}", url)))?;
+            std::fs::read(&path).map_err(|e| Error::new(format!("{}: {}", path.display(), e)))
+        }
+        Some(_) => {
+            require_curl()?;
+            let out = Command::new("curl")
+                .args([
+                    "--fail",
+                    "--location",
+                    "--silent",
+                    "--show-error",
+                    "--retry",
+                    "2",
+                    "--connect-timeout",
+                    "20",
+                    "--max-time",
+                    "300",
+                    "--max-redirs",
+                    "5",
+                    url,
+                ])
+                .output()
+                .map_err(|e| Error::new(format!("failed to run curl: {}", e)))?;
+            if !out.status.success() {
+                let stderr = String::from_utf8_lossy(&out.stderr).trim().to_string();
+                return Err(Error::new(format!(
+                    "download failed for {}: {}",
+                    url,
+                    if stderr.is_empty() {
+                        format!("curl exited with {}", out.status)
+                    } else {
+                        stderr
+                    }
+                )));
+            }
+            Ok(out.stdout)
+        }
+        None => Err(Error::new(format!("unsupported URL scheme: {}", url))),
+    }
+}
+
+/// Fetch a URL to a file, atomically (download to `.part`, then rename).
+pub fn fetch_to_file(url: &str, dest: &Path) -> Result<()> {
+    if let Some(parent) = dest.parent() {
+        std::fs::create_dir_all(parent)
+            .map_err(|e| Error::new(format!("{}: {}", parent.display(), e)))?;
+    }
+    let tmp = dest.with_extension("part");
+    match scheme_of(url) {
+        Some(Scheme::File) => {
+            let src = local_path(url).ok_or_else(|| Error::new(format!("bad file URL {}", url)))?;
+            std::fs::copy(&src, &tmp)
+                .map_err(|e| Error::new(format!("{}: {}", src.display(), e)))?;
+        }
+        Some(_) => {
+            require_curl()?;
+            let mut cmd = Command::new("curl");
+            cmd.args([
+                "--fail",
+                "--location",
+                "--silent",
+                "--show-error",
+                "--retry",
+                "2",
+                "--connect-timeout",
+                "20",
+                "--max-time",
+                "1800",
+                "--output",
+            ])
+            .arg(&tmp)
+            .arg(url);
+            let out = cmd
+                .output()
+                .map_err(|e| Error::new(format!("failed to run curl: {}", e)))?;
+            if !out.status.success() {
+                let _ = std::fs::remove_file(&tmp);
+                let stderr = String::from_utf8_lossy(&out.stderr).trim().to_string();
+                return Err(Error::new(format!(
+                    "download failed for {}: {}",
+                    url,
+                    if stderr.is_empty() {
+                        format!("curl exited with {}", out.status)
+                    } else {
+                        stderr
+                    }
+                )));
+            }
+        }
+        None => return Err(Error::new(format!("unsupported URL scheme: {}", url))),
+    }
+    std::fs::rename(&tmp, dest).map_err(|e| Error::new(format!("{}: {}", dest.display(), e)))?;
+    Ok(())
+}
+
+/// Try a list of base URLs in order until one succeeds, returning the one that
+/// worked. Mirrors are tried sequentially on purpose: it keeps failures
+/// debuggable and avoids hammering every mirror at once.
+pub fn fetch_bytes_from_mirrors(
+    bases: &[String],
+    rel: &str,
+) -> Result<(String, Vec<u8>)> {
+    let mut last_err = None;
+    for base in bases {
+        let url = join_url(base, rel);
+        match fetch_bytes(&url) {
+            Ok(bytes) => return Ok((base.clone(), bytes)),
+            Err(e) => last_err = Some(e),
+        }
+    }
+    Err(last_err.unwrap_or_else(|| Error::new("no mirrors available")))
+}
+
+/// Compression of a metadata file, inferred from its name.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Compression {
+    None,
+    Gzip,
+    Xz,
+    Zstd,
+    Bzip2,
+    Lzma,
+}
+
+impl Compression {
+    pub fn from_filename(name: &str) -> Compression {
+        let lower = name.to_ascii_lowercase();
+        if lower.ends_with(".gz") {
+            Compression::Gzip
+        } else if lower.ends_with(".xz") {
+            Compression::Xz
+        } else if lower.ends_with(".zst") || lower.ends_with(".zstd") {
+            Compression::Zstd
+        } else if lower.ends_with(".bz2") {
+            Compression::Bzip2
+        } else if lower.ends_with(".lzma") {
+            Compression::Lzma
+        } else {
+            Compression::None
+        }
+    }
+
+    pub fn command(self) -> Option<(&'static str, &'static [&'static str])> {
+        match self {
+            Compression::None => None,
+            Compression::Gzip => Some(("gzip", &["-dc"])),
+            Compression::Xz => Some(("xz", &["-dc"])),
+            Compression::Zstd => Some(("zstd", &["-dc"])),
+            Compression::Bzip2 => Some(("bzip2", &["-dc"])),
+            Compression::Lzma => Some(("xz", &["--format=lzma", "-dc"])),
+        }
+    }
+}
+
+/// Decompress (or pass through) metadata bytes using the system tool.
+pub fn decompress(data: Vec<u8>, compression: Compression) -> Result<Vec<u8>> {
+    let Some((program, args)) = compression.command() else {
+        return Ok(data);
+    };
+
+    let mut child = Command::new(program)
+        .args(args)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .map_err(|_| {
+            Error::new(format!(
+                "cannot decompress metadata: '{}' not found in PATH \
+                 (install it, or point the repo at uncompressed metadata)",
+                program
+            ))
+        })?;
+
+    // Feed stdin from a separate thread: writing a large buffer inline while
+    // the child fills its stdout pipe would deadlock.
+    let mut stdin = child
+        .stdin
+        .take()
+        .ok_or_else(|| Error::new(format!("cannot write to {}", program)))?;
+    let writer = std::thread::spawn(move || {
+        let _ = stdin.write_all(&data);
+    });
+
+    let out = child
+        .wait_with_output()
+        .map_err(|e| Error::new(format!("{}: {}", program, e)))?;
+    let _ = writer.join();
+
+    if !out.status.success() {
+        return Err(Error::new(format!(
+            "{} failed to decompress metadata: {}",
+            program,
+            String::from_utf8_lossy(&out.stderr).trim()
+        )));
+    }
+    Ok(out.stdout)
+}
+
+/// Convenience: decompress metadata and interpret it as UTF-8 text.
+pub fn decompress_to_string(data: Vec<u8>, name: &str) -> Result<String> {
+    let bytes = decompress(data, Compression::from_filename(name))?;
+    String::from_utf8(bytes)
+        .map_err(|e| Error::new(format!("metadata {} is not valid UTF-8: {}", name, e)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn url_handling() {
+        assert_eq!(scheme_of("file:///tmp/x"), Some(Scheme::File));
+        assert_eq!(scheme_of("/tmp/x"), Some(Scheme::File));
+        assert_eq!(scheme_of("https://example.org/x"), Some(Scheme::Https));
+        assert_eq!(scheme_of("http://example.org/x"), Some(Scheme::Http));
+        assert_eq!(scheme_of("ftp://example.org/x"), None);
+
+        assert_eq!(
+            local_path("file:///tmp/x").unwrap(),
+            PathBuf::from("/tmp/x")
+        );
+        assert!(local_path("file://host/x").is_none());
+
+        assert_eq!(
+            join_url("https://e.org/repo/", "repodata/repomd.xml"),
+            "https://e.org/repo/repodata/repomd.xml"
+        );
+        assert_eq!(
+            join_url("https://e.org/repo", "/repodata/repomd.xml"),
+            "https://e.org/repo/repodata/repomd.xml"
+        );
+    }
+
+    #[test]
+    fn compression_detection() {
+        assert_eq!(
+            Compression::from_filename("primary.xml.gz"),
+            Compression::Gzip
+        );
+        assert_eq!(
+            Compression::from_filename("primary.xml.zst"),
+            Compression::Zstd
+        );
+        assert_eq!(Compression::from_filename("primary.xml.xz"), Compression::Xz);
+        assert_eq!(
+            Compression::from_filename("primary.xml"),
+            Compression::None
+        );
+    }
+
+    #[test]
+    fn gzip_roundtrip_via_system_tool() {
+        // Build a gzip stream with the system gzip, then decompress it through
+        // the same path RPF uses in production.
+        let child = Command::new("sh")
+            .arg("-c")
+            .arg("printf 'hello rpf' | gzip -c")
+            .stdout(Stdio::piped())
+            .spawn()
+            .expect("sh available");
+        let out = child.wait_with_output().unwrap();
+        assert!(out.status.success());
+        let text = decompress_to_string(out.stdout, "x.xml.gz").unwrap();
+        assert_eq!(text, "hello rpf");
+    }
+
+    #[test]
+    fn uncompressed_passthrough() {
+        let text = decompress_to_string(b"<a/>".to_vec(), "x.xml").unwrap();
+        assert_eq!(text, "<a/>");
+    }
+
+    #[test]
+    fn local_file_fetch() {
+        let dir = std::env::temp_dir().join(format!("rpf-fetch-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let path = dir.join("data.txt");
+        std::fs::write(&path, b"content").unwrap();
+
+        let url = format!("file://{}", path.display());
+        assert_eq!(fetch_bytes(&url).unwrap(), b"content");
+
+        let dest = dir.join("copy.txt");
+        fetch_to_file(&url, &dest).unwrap();
+        assert_eq!(std::fs::read(&dest).unwrap(), b"content");
+
+        // Missing files surface as errors, not panics.
+        assert!(fetch_bytes("file:///nonexistent/x").is_err());
+    }
+}
diff --git a/src/ini.rs b/src/ini.rs
new file mode 100644
index 0000000..049993e
--- /dev/null
+++ b/src/ini.rs
@@ -0,0 +1,224 @@
+//! Parser for `.repo` files and `rpf.conf` (the INI dialect dnf uses).
+//!
+//! Deliberately permissive: real-world repo files contain quoted values,
+//! inline comments after values, CRLF line endings and duplicate keys
+//! (last one wins), and a package manager that chokes on them is a bad
+//! package manager.
+
+use crate::{Error, Result};
+
+#[derive(Debug, Clone, Default)]
+pub struct Section {
+    pub name: String,
+    entries: Vec<(String, String)>,
+}
+
+impl Section {
+    pub fn get(&self, key: &str) -> Option<&str> {
+        self.entries
+            .iter()
+            .rev()
+            .find(|(k, _)| k == key)
+            .map(|(_, v)| v.as_str())
+    }
+
+    /// Interpret a value as a boolean the way dnf does (`1/0`, `yes/no`,
+    /// `true/false`, case-insensitive).
+    pub fn get_bool(&self, key: &str) -> Option<bool> {
+        self.get(key).map(parse_bool).or(None).and_then(|b| b)
+    }
+
+    pub fn get_bool_or(&self, key: &str, default: bool) -> bool {
+        self.get_bool(key).unwrap_or(default)
+    }
+
+    pub fn get_i64_or(&self, key: &str, default: i64) -> i64 {
+        self.get(key)
+            .and_then(|v| v.trim().parse::<i64>().ok())
+            .unwrap_or(default)
+    }
+
+    pub fn get_u32_or(&self, key: &str, default: u32) -> u32 {
+        self.get(key)
+            .and_then(|v| v.trim().parse::<u32>().ok())
+            .unwrap_or(default)
+    }
+
+    /// Split a whitespace/comma separated list value.
+    pub fn get_list(&self, key: &str) -> Vec<String> {
+        self.get(key)
+            .map(|v| {
+                v.split(|c: char| c.is_whitespace() || c == ',')
+                    .map(|s| s.trim().to_string())
+                    .filter(|s| !s.is_empty())
+                    .collect()
+            })
+            .unwrap_or_default()
+    }
+
+    pub fn entries(&self) -> &[(String, String)] {
+        &self.entries
+    }
+
+    pub fn set(&mut self, key: &str, value: &str) {
+        if let Some(existing) = self.entries.iter_mut().find(|(k, _)| k == key) {
+            existing.1 = value.to_string();
+        } else {
+            self.entries.push((key.to_string(), value.to_string()));
+        }
+    }
+}
+
+fn parse_bool(v: &str) -> Option<bool> {
+    match v.trim().to_ascii_lowercase().as_str() {
+        "1" | "yes" | "true" | "on" | "enabled" => Some(true),
+        "0" | "no" | "false" | "off" | "disabled" => Some(false),
+        _ => None,
+    }
+}
+
+#[derive(Debug, Clone, Default)]
+pub struct Ini {
+    pub sections: Vec<Section>,
+    /// Text before the first section header, useful for diagnostics.
+    pub preamble: Vec<String>,
+}
+
+impl Ini {
+    pub fn parse(text: &str) -> Result<Ini> {
+        let mut ini = Ini::default();
+        let mut current: Option<Section> = None;
+
+        for raw in text.lines() {
+            // Normalise CRLF and strip a UTF-8 BOM on the first line.
+            let line = raw.trim_start_matches('\u{feff}').trim();
+
+            if line.is_empty() || line.starts_with('#') || line.starts_with(';') {
+                continue;
+            }
+
+            if line.starts_with('[') {
+                let end = line.find(']').ok_or_else(|| {
+                    Error::new(format!("malformed section header: {:?}", line))
+                })?;
+                let name = line[1..end].trim().to_string();
+                if name.is_empty() {
+                    return Err(Error::new("empty section name"));
+                }
+                if let Some(sec) = current.take() {
+                    ini.sections.push(sec);
+                }
+                current = Some(Section {
+                    name,
+                    entries: Vec::new(),
+                });
+                continue;
+            }
+
+            let Some(sec) = current.as_mut() else {
+                ini.preamble.push(line.to_string());
+                continue;
+            };
+
+            let Some(eq) = line.find('=') else {
+                // A bare key is legal-ish; record it as an empty value.
+                sec.entries.push((line.to_string(), String::new()));
+                continue;
+            };
+
+            let key = line[..eq].trim().to_ascii_lowercase();
+            if key.is_empty() {
+                continue;
+            }
+            let mut value = line[eq + 1..].trim().to_string();
+
+            // Strip matching quotes.
+            if value.len() >= 2 {
+                let b = value.as_bytes();
+                if (b[0] == b'"' && b[b.len() - 1] == b'"')
+                    || (b[0] == b'\'' && b[b.len() - 1] == b'\'')
+                {
+                    value = value[1..value.len() - 1].to_string();
+                }
+            }
+            sec.entries.push((key, value));
+        }
+
+        if let Some(sec) = current.take() {
+            ini.sections.push(sec);
+        }
+        Ok(ini)
+    }
+
+    pub fn section(&self, name: &str) -> Option<&Section> {
+        self.sections.iter().find(|s| s.name == name)
+    }
+
+    pub fn section_mut(&mut self, name: &str) -> Option<&mut Section> {
+        self.sections.iter_mut().find(|s| s.name == name)
+    }
+
+    pub fn section_names(&self) -> Vec<String> {
+        self.sections.iter().map(|s| s.name.clone()).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_a_fedora_repo_file() {
+        let text = r#"
+# comment
+[fedora]
+name=Fedora $releasever - $basearch
+metalink=https://mirrors.fedoraproject.org/metalink?repo=fedora-$releasever&arch=$basearch
+enabled=1
+gpgcheck=1
+gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-$releasever-$basearch
+
+[fedora-debuginfo]
+name=Fedora $releasever - $basearch - Debug
+enabled=0
+"#;
+        let ini = Ini::parse(text).unwrap();
+        assert_eq!(ini.section_names(), vec!["fedora", "fedora-debuginfo"]);
+
+        let fedora = ini.section("fedora").unwrap();
+        assert_eq!(fedora.get("name"), Some("Fedora $releasever - $basearch"));
+        assert!(fedora.get_bool("enabled").unwrap());
+        assert!(!ini.section("fedora-debuginfo").unwrap().get_bool("enabled").unwrap());
+        assert_eq!(fedora.get_list("gpgkey").len(), 1);
+    }
+
+    #[test]
+    fn tolerates_quotes_comments_and_crlf() {
+        let text = "[a]\r\nname = \"Quoted Value\"\r\nenabled=yes\r\n; note\r\n";
+        let ini = Ini::parse(text).unwrap();
+        let a = ini.section("a").unwrap();
+        assert_eq!(a.get("name"), Some("Quoted Value"));
+        assert_eq!(a.get_bool("enabled"), Some(true));
+    }
+
+    #[test]
+    fn multiple_values_in_one_key() {
+        let text = "[a]\nbaseurl=https://one/ https://two/\ngpgkey=file:///k1 file:///k2\n";
+        let ini = Ini::parse(text).unwrap();
+        let a = ini.section("a").unwrap();
+        assert_eq!(a.get_list("baseurl"), vec!["https://one/", "https://two/"]);
+        assert_eq!(a.get_list("gpgkey"), vec!["file:///k1", "file:///k2"]);
+    }
+
+    #[test]
+    fn last_duplicate_key_wins() {
+        let text = "[a]\nenabled=0\nenabled=1\n";
+        let ini = Ini::parse(text).unwrap();
+        assert_eq!(ini.section("a").unwrap().get_bool("enabled"), Some(true));
+    }
+
+    #[test]
+    fn malformed_section_is_an_error() {
+        assert!(Ini::parse("[unclosed\nkey=1\n").is_err());
+    }
+}
