+    f.stdout(&["makecache"]);
+    assert!(f.path("cache/testrepo").exists());
+    let out = f.stdout(&["clean", "all"]);
+    assert!(out.contains("Removed"), "{}", out);
+    assert!(!f.path("cache/testrepo").exists());
+}
