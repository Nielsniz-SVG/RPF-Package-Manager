diff --git a/tests/install.rs b/tests/install.rs
new file mode 100644
index 0000000..461f343
--- /dev/null
+++ b/tests/install.rs
@@ -0,0 +1,702 @@
+//! End-to-end install and remove tests, driven through the real binary against
+//! packages and a repository generated by `tests/common`.
+
+mod common;
+
+use common::*;
+use std::os::unix::fs::MetadataExt;
+
+#[test]
+fn installs_package_from_repository() {
+    let fx = RepoFixture::new("install-basic");
+    fx.publish(&[PkgSpec::new("hello", "1.0")
+        .with_file(FileSpec::new("/usr/bin/hello", "#!/bin/sh\necho hello\n").executable())
+        .with_file(FileSpec::new("/etc/hello.conf", "greeting=hello\n"))]);
+
+    let root = fx.ensure_installroot();
+    let out = fx.rpf_root(&["install", "hello"]);
+    assert_success(&out, "install hello");
+    assert!(text(&out).contains("Complete!"), "{}", text(&out));
+
+    let bin = root.join("usr/bin/hello");
+    assert!(file_exists(&bin), "binary should be installed");
+    assert_eq!(read(&bin), "#!/bin/sh\necho hello\n");
+    assert_eq!(
+        std::fs::metadata(&bin).unwrap().mode() & 0o777,
+        0o755,
+        "executable bit must be preserved"
+    );
+
+    let conf = root.join("etc/hello.conf");
+    assert_eq!(read(&conf), "greeting=hello\n");
+
+    // The package is recorded with its file manifest.
+    let db = read(&root.join("var/lib/rpf/installed.rpf"));
+    assert!(db.contains("hello"), "{}", db);
+    assert!(db.contains("/usr/bin/hello"), "{}", db);
+}
+
+#[test]
+fn resolves_and_installs_dependencies() {
+    let fx = RepoFixture::new("install-deps");
+    fx.publish(&[
+        PkgSpec::new("app", "2.0")
+            .with_file(FileSpec::new("/usr/bin/app", "app\n").executable())
+            .with_requires("libfoo"),
+        PkgSpec::new("libfoo", "1.5").with_file(FileSpec::new("/usr/lib/libfoo.so", "lib\n")),
+    ]);
+
+    let root = fx.ensure_installroot();
+    let out = fx.rpf_root(&["install", "app"]);
+    assert_success(&out, "install app");
+    let out_text = text(&out);
+    assert!(out_text.contains("libfoo-1.5"), "{}", out_text);
+    // Dependency order: libfoo listed before app.
+    let lib_pos = out_text.find("libfoo-1.5").unwrap();
+    let app_pos = out_text.find("app-2.0").unwrap();
+    assert!(lib_pos < app_pos, "dependency must come first:\n{}", out_text);
+
+    assert!(file_exists(&root.join("usr/lib/libfoo.so")));
+    assert!(file_exists(&root.join("usr/bin/app")));
+}
+
+#[test]
+fn config_noreplace_keeps_local_changes() {
+    let fx = RepoFixture::new("noreplace");
+    // Two versions of the same package, published together; the newer one wins.
+    let v1 = PkgSpec::new("conf", "1.0").with_file(
+        FileSpec::new("/etc/conf/app.conf", "version=1\n").config(true),
+    );
+    fx.publish(&[v1]);
+    let root = fx.ensure_installroot();
+    assert_success(&fx.rpf_root(&["install", "conf"]), "install v1");
+
+    let conf = root.join("etc/conf/app.conf");
+    std::fs::write(&conf, "version=1\nlocal_change=yes\n").unwrap();
+
+    // Publish v2 and install it.
+    let v2 = PkgSpec::new("conf", "2.0").with_file(
+        FileSpec::new("/etc/conf/app.conf", "version=2\n").config(true),
+    );
+    fx.publish(&[v2]);
+    let out = fx.rpf_root(&["install", "--refresh", "conf"]);
+    assert_success(&out, "install v2");
+
+    assert_eq!(
+        read(&conf),
+        "version=1\nlocal_change=yes\n",
+        "local edits must survive"
+    );
+    let rpmnew = root.join("etc/conf/app.conf.rpmnew");
+    assert!(file_exists(&rpmnew), "new config should be saved as .rpmnew");
+    assert_eq!(read(&rpmnew), "version=2\n");
+}
+
+#[test]
+fn plain_config_saves_rpmsave() {
+    let fx = RepoFixture::new("rpmsave");
+    fx.publish(&[PkgSpec::new("cfg", "1.0")
+        .with_file(FileSpec::new("/etc/cfg/c.conf", "original=1\n").config(true))]);
+    let root = fx.ensure_installroot();
